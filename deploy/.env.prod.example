# Bsheel API — production environment template.
#
# Copy via ./gen-secrets.sh (which fills the __PLACEHOLDER__ secrets).
# Anything still reading REPLACE_ME must be filled in by hand.
#
# NEVER commit the generated .env.prod. It is gitignored.

NODE_ENV=production
PORT=3000
APP_NAME=bsheel-api
APP_VERSION=1.0.0
API_PREFIX=api

# The admin dashboard's origin. The mobile app is not a browser and sends no
# Origin header, so it does not belong here. Add nothing you do not control:
# every origin listed can read authenticated API responses.
CORS_ORIGINS=https://admin.bsheel.app

# ---------------------------------------------------------------------------
# Datastores — compose service names, NOT localhost.
#
# 127.0.0.1:5432 on this box is the LIVE SUPABASE database serving quest-app.
# Pointing DATABASE_URL there would run Bsheel's forward-only migrations
# against production data. preflight.sh refuses to deploy if this host is
# localhost/127.0.0.1. Do not "fix" it by changing the check.
# ---------------------------------------------------------------------------
POSTGRES_DB=bsheel_prod
POSTGRES_USER=bsheel
POSTGRES_PASSWORD=__DB_PASSWORD__
DATABASE_URL=postgresql://bsheel:__DB_PASSWORD__@postgres:5432/bsheel_prod

DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_WORKER_POOL_MAX=12
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://redis:6379
# Distinct prefix so Bsheel keys can never be confused with anything else
# that might later share a Redis.
REDIS_KEY_PREFIX=bsheel:prod:
OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# Crypto — four INDEPENDENT secrets, generated by gen-secrets.sh.
# The schema rejects any of these under 32 chars or containing "change-me"
# when NODE_ENV=production, so the API will not boot with placeholders.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=__JWT_ACCESS_SECRET__
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_REFRESH_TTL_SECONDS=2592000
DEVICE_TOKEN_ENCRYPTION_KEY=__DEVICE_TOKEN_ENCRYPTION_KEY__
AUTH_ACTION_TOKEN_ENCRYPTION_KEY=__AUTH_ACTION_TOKEN_ENCRYPTION_KEY__

# ---------------------------------------------------------------------------
# Auth
#
# Confirmation is set to false because NO email provider is wired yet
# (EMAIL_DELIVERY_WEBHOOK_URL is empty below). With it true and no mail
# transport, a new signup is created and can never confirm — so nobody can
# register on TestFlight. Set this to true in the same change that wires
# email delivery, not before.
# ---------------------------------------------------------------------------
AUTH_EMAIL_CONFIRMATION_REQUIRED=false
APP_PUBLIC_URL=https://admin.bsheel.app

# Social login. These are the client IDs compiled into the shipped app
# (dart_defines.release.json) — they must match or Google sign-in fails.
OAUTH_GOOGLE_CLIENT_IDS=854270137441-vhigjmc9rgr2jog9u0d091pb2e02ohi1.apps.googleusercontent.com,854270137441-t7fnj89odpeut06588o1dee181n3bdsr.apps.googleusercontent.com
OAUTH_APPLE_CLIENT_IDS=com.questapp.mobileApp
OAUTH_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Push notifications
#
# The whole service-account JSON on ONE line, single-quoted. Copy it from
# your local backend/.env, which already has a working value.
#
# This is not cosmetic: per CLAUDE.md, tapping a notification is the PRIMARY
# route to the appeal flow. With push off, a rejected user has a much harder
# time finding it.
# ---------------------------------------------------------------------------
PUSH_NOTIFICATIONS_ENABLED=true
FIREBASE_SERVICE_ACCOUNT='REPLACE_ME_WITH_ONE_LINE_SERVICE_ACCOUNT_JSON'
FIREBASE_PROJECT_ID=bitsheel
FIREBASE_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Email — not wired. Both must be set together or the schema rejects the
# config. Leave both empty until a provider exists; password reset is inert
# until then (a known, documented gap).
# ---------------------------------------------------------------------------
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_TIMEOUT_MS=10000

# Telegram — off. If enabled, BOT_TOKEN, ADMIN_CHAT_ID and WEBHOOK_SECRET
# all become required.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_API_BASE_URL=https://api.telegram.org

# ---------------------------------------------------------------------------
# Object storage — REQUIRED for the core loop.
#
# Submitting photo/video proof writes here. With this wrong, users pick a
# quest, shoot their proof, and the upload fails — the app looks broken at
# exactly its most important moment.
#
# Pick ONE of the two blocks below.
#
# OPTION A — self-hosted MinIO on this box (no external account needed).
#   Bring it up with:  docker compose --profile storage up -d
#   Needs a DNS A record: media.bsheel.app -> this server, and the Caddy
#   block for it (see caddy-bsheel.caddy). Path-style addressing, because
#   there is no wildcard DNS in front of it.
R2_ENDPOINT=https://media.bsheel.app
R2_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
R2_ACCESS_KEY_ID=REPLACE_ME_MINIO_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_ME_MINIO_SECRET_KEY
R2_BUCKET=bsheel-prod
R2_PUBLIC_BASE_URL=https://media.bsheel.app/bsheel-prod
MINIO_ROOT_USER=REPLACE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=REPLACE_ME_MINIO_SECRET_KEY

# OPTION B — Cloudflare R2 (recommended: no disk pressure on this VPS, and
# you already have an R2 account). Create a NEW bucket; do not reuse
# quest-app's. Then comment out Option A above and use:
#
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_REGION=auto
# S3_FORCE_PATH_STYLE=false
# R2_ACCESS_KEY_ID=<r2 access key>
# R2_SECRET_ACCESS_KEY=<r2 secret>
# R2_BUCKET=bsheel-prod
# R2_PUBLIC_BASE_URL=https://<your r2 public domain>

SIGNED_URL_TTL_SECONDS=900

MEDIA_MAX_SUBMISSION_OBJECTS_PER_USER=5000
MEDIA_MAX_AVATAR_OBJECTS_PER_USER=20
MEDIA_MAX_AVATAR_BYTES=5242880
MEDIA_MAX_SUBMISSION_BYTES=52428800

# The reclaim sweep deletes objects nothing references. The grace period must
# exceed the gap between an upload finishing and its submission row existing,
# or it reclaims live media.
MEDIA_RECLAIM_ENABLED=true
MEDIA_RECLAIM_INTERVAL_MS=3600000
MEDIA_RECLAIM_GRACE_HOURS=24
MEDIA_RECLAIM_BATCH_SIZE=200

# ---------------------------------------------------------------------------
# Ops
# ---------------------------------------------------------------------------
LOG_LEVEL=info
# Off in production: /docs would publish the full API surface unauthenticated.
SWAGGER_ENABLED=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Per-client cap on login / register / phone start / password recovery /
# confirmation resend. The API trusts exactly one proxy hop (Caddy), so
# this is per real client, not per proxy.
AUTH_THROTTLE_LIMIT=20

# ---------------------------------------------------------------------------
# AI agent + Nokia Network as Code
# ---------------------------------------------------------------------------
AGENT_SUBMISSION_VERIFICATION_ENABLED=true
AGENT_RUN_LEASE_SECONDS=900
AGENT_RECOVERY_SWEEP_INTERVAL_MS=600000
AGENT_RECOVERY_SWEEP_BATCH_SIZE=25
OPENAI_AGENT_ENABLED=true
OPENAI_API_KEY=REPLACE_ME_OPENAI_API_KEY
OPENAI_AGENT_MODEL=REPLACE_ME_OPENAI_MODEL
OPENAI_AGENT_TIMEOUT_MS=30000
OPENAI_AGENT_MAX_TURNS=6
OPENAI_AGENT_PROMPT_VERSION=v1
OPENAI_TRACING_ENABLED=false
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=

# The #47 vision cascade: what the agent reads as its CV evidence. Without
# it the agent is blind and escalates every submission to a moderator.
AI_VERIFICATION_ENABLED=true
AI_VERIFICATION_PROVIDER=openai
# The single "may automation act" switch, read by both verifiers. false =
# the agent approves and rejects for real; true = it records and acts on
# nothing, which is the eval slice `npm run proof:eval` scores.
AI_VERIFICATION_SHADOW_MODE=false

CAMARA_ENABLED=true
CAMARA_API_KEY=REPLACE_ME_CAMARA_API_KEY
CAMARA_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com
CAMARA_REQUEST_TIMEOUT_MS=10000
CAMARA_GEOFENCING_SINK_BASE_URL=https://api.bsheel.app/api/v1/integrations/camara/geofencing

# Normally discovered from Nokia. Fill only if the deployed account needs
# its Number Verification metadata pinned explicitly.
CAMARA_NUMBER_VERIFICATION_AUTHORIZE_URL=
CAMARA_NUMBER_VERIFICATION_TOKEN_URL=
CAMARA_NUMBER_VERIFICATION_CLIENT_ID=
CAMARA_NUMBER_VERIFICATION_CLIENT_SECRET=
CAMARA_NUMBER_VERIFICATION_REDIRECT_URI=https://api.bsheel.app/api/v1/auth/phone/callback
PHONE_SIGNIN_MOBILE_REDIRECT_URL=https://api.bsheel.app/phone-signin-callback
# Browser-only local/testing handoff. Leave empty in the mobile production deployment.
PHONE_SIGNIN_WEB_APP_URL=
# Used by the public association documents served from api.bsheel.app.
IOS_APP_ID=JMDKX9TYX6.com.questapp.mobileApp
ANDROID_PACKAGE_NAME=com.questapp.mobileApp
ANDROID_CERT_FINGERPRINT=REPLACE_ME_ANDROID_SHA256_FINGERPRINT

# The CV teammate will change this to http and provide the two values below.
# Until then, proof decisions safely remain HUMAN_REVIEW.
CV_PROVIDER=none
CV_SERVICE_BASE_URL=
CV_SERVICE_AUTH_TOKEN=
CV_TIMEOUT_MS=20000
SUBMISSION_VERIFICATION_CONCURRENCY=2
QUEST_ASSIGNMENT_AGENT_CONCURRENCY=2

AGENT_QUEST_TIME_MIN_MINUTES=240
AGENT_QUEST_TIME_MAX_MINUTES=20160
AGENT_XP_MIN=5
AGENT_XP_MAX=100
AGENT_APPROVE_CONFIDENCE_THRESHOLD=0.85
AGENT_REJECT_CONFIDENCE_THRESHOLD=0.85

# Container resource caps — this box also runs the live Supabase stack.
# Raise only after preflight.sh shows real headroom.
API_BIND_PORT=3010
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=1.0
REDIS_MEM_LIMIT=384m
REDIS_CPUS=0.5
REDIS_MAXMEMORY=256mb
API_MEM_LIMIT=768m
API_CPUS=1.0
WORKER_MEM_LIMIT=512m
WORKER_CPUS=0.5
