NODE_ENV=development
PORT=3000
APP_NAME=bsheel-api
APP_VERSION=1.0.0
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgresql://bsheel:bsheel@localhost:5432/bsheel
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_WORKER_POOL_MAX=12
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=bsheel:dev:
OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=50

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_TTL_SECONDS=2592000
DEVICE_TOKEN_ENCRYPTION_KEY=replace-with-a-third-independent-32-character-secret
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=bitsheel
FIREBASE_TIMEOUT_MS=10000
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_APPLE_CLIENT_IDS=
OAUTH_TIMEOUT_MS=10000
AUTH_ACTION_TOKEN_ENCRYPTION_KEY=replace-with-a-fourth-independent-32-character-secret
AUTH_EMAIL_CONFIRMATION_REQUIRED=true
APP_PUBLIC_URL=https://admin.bsheel.app
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_TIMEOUT_MS=10000
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_API_BASE_URL=https://api.telegram.org

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Only when the store is addressed differently from inside the network than
# from a browser (a containerised MinIO). Blank for real R2.
S3_INTERNAL_ENDPOINT=
R2_REGION=auto
# Set true for MinIO or any self-hosted S3; R2 accepts either.
S3_FORCE_PATH_STYLE=false
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=bsheel-dev
R2_PUBLIC_BASE_URL=https://media-dev.example.com
SIGNED_URL_TTL_SECONDS=900

# Per-user object caps (indexed COUNT, not a bucket listing).
MEDIA_MAX_SUBMISSION_OBJECTS_PER_USER=5000
MEDIA_MAX_AVATAR_OBJECTS_PER_USER=20
MEDIA_MAX_AVATAR_BYTES=5242880
MEDIA_MAX_SUBMISSION_BYTES=52428800

# Reclaim sweep: deletes objects nothing references any more. The grace
# period must exceed the time between an upload completing and its
# submission being created, or it will reclaim live media.
MEDIA_RECLAIM_ENABLED=true
MEDIA_RECLAIM_INTERVAL_MS=3600000
MEDIA_RECLAIM_GRACE_HOURS=24
MEDIA_RECLAIM_BATCH_SIZE=200
QUEST_MAINTENANCE_ENABLED=true
QUEST_MAINTENANCE_INTERVAL_MS=300000
PENDING_REVIEW_REMINDER_INTERVAL_MS=3600000
QUEST_MAINTENANCE_BATCH_SIZE=500

LOG_LEVEL=debug
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# AI agent phase (submission verification). Disabled by default — the whole
# pipeline is inert with these left as-is. QoS on Demand / Emergency Mode is
# out of scope for this phase.
AGENT_SUBMISSION_VERIFICATION_ENABLED=false
OPENAI_AGENT_ENABLED=false
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=
OPENAI_AGENT_TIMEOUT_MS=30000
OPENAI_AGENT_MAX_TURNS=6
OPENAI_AGENT_PROMPT_VERSION=v1
OPENAI_TRACING_ENABLED=false
OPENAI_PROJECT_ID=
OPENAI_ORGANIZATION_ID=

# Nokia Network-as-Code / CAMARA. The SDK-backed Location Verification,
# Location Retrieval and Geofencing adapters require the Nokia/RapidAPI key.
# Provider failures fail closed to UNAVAILABLE.
CAMARA_ENABLED=false
CAMARA_BASE_URL=
CAMARA_API_KEY=
CAMARA_TOKEN_URL=
CAMARA_CLIENT_ID=
CAMARA_CLIENT_SECRET=
CAMARA_SCOPE=
CAMARA_REQUEST_TIMEOUT_MS=10000
# Public URL CAMARA posts geofence entry/exit events to. Must be reachable
# from the internet or no geofence evidence ever arrives. The subscription
# local subscription id is appended; the secret is sent as a bearer sink
# credential and never appears in the URL.
CAMARA_GEOFENCING_SINK_BASE_URL=
# x-rapidapi-host ROUTING KEY (not an address — it has no DNS record).
# Leave blank: the backend defaults to network-as-code.nokia.rapidapi.com,
# which is what Nokia documents and the only value that routes to the API.
# Sending the connect host instead yields 404 "API doesn't exists".
CAMARA_RAPIDAPI_HOST=

# CAMARA Number Verification (issue #1) — a separate 3-legged flow from the
# evidence adapter above. The four endpoint/client fields are optional
# overrides; by default they are discovered from Nokia at runtime.
# CAMARA_NUMBER_VERIFICATION_REDIRECT_URI is OUR backend's own callback
# (e.g. https://api.bsheel.app/api/v1/auth/phone/callback) —
# register that exact value with Nokia. PHONE_SIGNIN_MOBILE_REDIRECT_URL
# MUST be exactly https://admin.bsheel.app/phone-signin-callback, the
# verified Universal Link / App Link path the mobile app listens for.
CAMARA_NUMBER_VERIFICATION_AUTHORIZE_URL=
CAMARA_NUMBER_VERIFICATION_TOKEN_URL=
CAMARA_NUMBER_VERIFICATION_CLIENT_ID=
CAMARA_NUMBER_VERIFICATION_CLIENT_SECRET=
CAMARA_NUMBER_VERIFICATION_REDIRECT_URI=
# MUST be on a PUBLIC host with no HTTP auth, and the SAME host that serves
# /.well-known/apple-app-site-association. Point it at the API, not the admin
# panel: admin.bsheel.app sits behind Basic auth, which met a TestFlight
# tester with a credential prompt for a host they have no account on.
PHONE_SIGNIN_MOBILE_REDIRECT_URL=https://api.bsheel.app/phone-signin-callback
# Only for a browser client, which cannot intercept a Universal Link. Blank
# in production: the app is the client, and the landing page is the fallback.
PHONE_SIGNIN_WEB_APP_URL=

# Computer vision. 'none' is fail-closed; 'http' calls CV_SERVICE_BASE_URL
# with the CvEvidenceSchema contract (see http-cv-evidence.provider.ts).
CV_PROVIDER=none
CV_SERVICE_BASE_URL=
CV_SERVICE_AUTH_TOKEN=
CV_TIMEOUT_MS=20000
SUBMISSION_VERIFICATION_CONCURRENCY=2

# The absolute range every AI recommendation is clamped into, never
# overridden by a model output. 4 hours is the floor even for the simplest
# at-home quest; 2 weeks is the rare ceiling for real long-distance travel.
# XP runs 5 (simple, no travel) to 100 (hard, genuinely travelled for it).
# The per-user shaping inside this range lives in verification-policy.ts.
AGENT_QUEST_TIME_MIN_MINUTES=240
AGENT_QUEST_TIME_MAX_MINUTES=20160
AGENT_XP_MIN=5
AGENT_XP_MAX=100
AGENT_APPROVE_CONFIDENCE_THRESHOLD=0.85
AGENT_REJECT_CONFIDENCE_THRESHOLD=0.85
STREAK_TIMEZONE=Asia/Beirut

# AI proof verification (#47). A cascade, not a single call:
#   0. deterministic forensics  — every submission, no model, ~free
#   1. triage                   — cheapest model, low image detail
#   2. deep                     — better model, only where triage could not tell
#   3. reject_review            — most capable model, REQUIRED before any reject
# The rungs differ ~50x in price, so most submissions must never reach the top.
AI_VERIFICATION_ENABLED=false
AI_VERIFICATION_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shadow mode records verdicts and acts on NOTHING. It is the default, and it
# stays the default until the eval has scored the agent against real human
# decisions. Turning this off lets the agent approve and reject for real.
AI_VERIFICATION_SHADOW_MODE=true

AI_VERIFICATION_MODEL_TRIAGE=gpt-5.6-luna
AI_VERIFICATION_MODEL_DEEP=gpt-5.6-sol
AI_VERIFICATION_MODEL_REJECT=gpt-6-astra
# Used when AI_VERIFICATION_PROVIDER=anthropic.
AI_VERIFICATION_MODEL_TRIAGE_ANTHROPIC=claude-haiku-4-5
AI_VERIFICATION_MODEL_DEEP_ANTHROPIC=claude-sonnet-5
AI_VERIFICATION_MODEL_REJECT_ANTHROPIC=claude-opus-5
AI_VERIFICATION_TIMEOUT_MS=60000

# The two errors are not symmetric. A false approval is recoverable through
# takedown and XP rollback; a false rejection tells an honest player they
# cheated. So the reject bar is higher, and the API refuses to boot if it is
# set at or below the approve bar. Set both from the eval, not by taste.
AI_VERIFICATION_APPROVE_MIN_CONFIDENCE=0.85
AI_VERIFICATION_REJECT_MIN_CONFIDENCE=0.95

# Perceptual-hash Hamming distance at or below which two images are the same
# picture. 10 of 64 bits sits above re-encode drift and below the distance
# between genuinely different photographs.
AI_VERIFICATION_NEAR_DUPLICATE_DISTANCE=10

AI_VERIFICATION_MAX_IMAGE_BYTES=3145728
AI_VERIFICATION_MAX_IMAGES=4

# Video proof is decoded into still frames with ffmpeg, sampled evenly across
# the clip rather than from the start (an opening frame is often a blur).
# Without ffmpeg installed, video escalates to a human as before.
AI_VERIFICATION_MAX_VIDEO_BYTES=52428800
AI_VERIFICATION_VIDEO_FRAMES=3
AI_VERIFICATION_FFMPEG_TIMEOUT_MS=30000
# Catch-up sweep for submissions the queue never finished analysing.
AI_VERIFICATION_SWEEP_INTERVAL_MS=900000
AI_VERIFICATION_SWEEP_BATCH_SIZE=25
AI_VERIFICATION_MAX_ATTEMPTS=3
