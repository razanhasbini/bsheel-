NODE_ENV=development
PORT=3000
APP_NAME=bsheel-api
APP_VERSION=1.0.0
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

DATABASE_URL=postgresql://bsheel:bsheel@localhost:5432/bsheel
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_WORKER_POOL_MAX=12
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=15000

REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=bsheel:dev:
OUTBOX_POLL_MS=250
OUTBOX_BATCH_SIZE=50

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_REFRESH_TTL_SECONDS=2592000
DEVICE_TOKEN_ENCRYPTION_KEY=replace-with-a-third-independent-32-character-secret
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=bitsheel
FIREBASE_TIMEOUT_MS=10000
OAUTH_GOOGLE_CLIENT_IDS=
OAUTH_APPLE_CLIENT_IDS=
OAUTH_TIMEOUT_MS=10000
AUTH_ACTION_TOKEN_ENCRYPTION_KEY=replace-with-a-fourth-independent-32-character-secret
AUTH_EMAIL_CONFIRMATION_REQUIRED=true
APP_PUBLIC_URL=https://admin.bsheel.app
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=
EMAIL_TIMEOUT_MS=10000
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_API_BASE_URL=https://api.telegram.org

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
# Set true for MinIO or any self-hosted S3; R2 accepts either.
S3_FORCE_PATH_STYLE=false
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET=bsheel-dev
R2_PUBLIC_BASE_URL=https://media-dev.example.com
SIGNED_URL_TTL_SECONDS=900

# Per-user object caps (indexed COUNT, not a bucket listing).
MEDIA_MAX_SUBMISSION_OBJECTS_PER_USER=5000
MEDIA_MAX_AVATAR_OBJECTS_PER_USER=20
MEDIA_MAX_AVATAR_BYTES=5242880
MEDIA_MAX_SUBMISSION_BYTES=52428800

# Reclaim sweep: deletes objects nothing references any more. The grace
# period must exceed the time between an upload completing and its
# submission being created, or it will reclaim live media.
MEDIA_RECLAIM_ENABLED=true
MEDIA_RECLAIM_INTERVAL_MS=3600000
MEDIA_RECLAIM_GRACE_HOURS=24
MEDIA_RECLAIM_BATCH_SIZE=200

LOG_LEVEL=debug
SWAGGER_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# AI proof verification (#47). A cascade, not a single call:
#   0. deterministic forensics  — every submission, no model, ~free
#   1. triage                   — cheapest model, low image detail
#   2. deep                     — better model, only where triage could not tell
#   3. reject_review            — most capable model, REQUIRED before any reject
# The rungs differ ~50x in price, so most submissions must never reach the top.
AI_VERIFICATION_ENABLED=false
AI_VERIFICATION_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Shadow mode records verdicts and acts on NOTHING. It is the default, and it
# stays the default until the eval has scored the agent against real human
# decisions. Turning this off lets the agent approve and reject for real.
AI_VERIFICATION_SHADOW_MODE=true

AI_VERIFICATION_MODEL_TRIAGE=gpt-5.6-luna
AI_VERIFICATION_MODEL_DEEP=gpt-5.6-sol
AI_VERIFICATION_MODEL_REJECT=gpt-6-astra
# Used when AI_VERIFICATION_PROVIDER=anthropic.
AI_VERIFICATION_MODEL_TRIAGE_ANTHROPIC=claude-haiku-4-5
AI_VERIFICATION_MODEL_DEEP_ANTHROPIC=claude-sonnet-5
AI_VERIFICATION_MODEL_REJECT_ANTHROPIC=claude-opus-5
AI_VERIFICATION_TIMEOUT_MS=60000

# The two errors are not symmetric. A false approval is recoverable through
# takedown and XP rollback; a false rejection tells an honest player they
# cheated. So the reject bar is higher, and the API refuses to boot if it is
# set at or below the approve bar. Set both from the eval, not by taste.
AI_VERIFICATION_APPROVE_MIN_CONFIDENCE=0.85
AI_VERIFICATION_REJECT_MIN_CONFIDENCE=0.95

# Perceptual-hash Hamming distance at or below which two images are the same
# picture. 10 of 64 bits sits above re-encode drift and below the distance
# between genuinely different photographs.
AI_VERIFICATION_NEAR_DUPLICATE_DISTANCE=10

AI_VERIFICATION_MAX_IMAGE_BYTES=3145728
AI_VERIFICATION_MAX_IMAGES=4
# Catch-up sweep for submissions the queue never finished analysing.
AI_VERIFICATION_SWEEP_INTERVAL_MS=900000
AI_VERIFICATION_SWEEP_BATCH_SIZE=25
AI_VERIFICATION_MAX_ATTEMPTS=3
