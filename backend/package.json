{
  "name": "@bsheel/backend",
  "version": "1.0.0",
  "description": "Bsheel API modular monolith",
  "author": "Bsheel",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/main.worker.js",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:all": "npm run lint && npm run test && npm run test:e2e && npm run build",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:check": "node scripts/migrate.mjs --check",
    "db:types": "node scripts/database-types.mjs > src/infrastructure/database/database.types.ts",
    "db:types:check": "node scripts/database-types.mjs --check",
    "test:smoke": "node scripts/smoke.mjs",
    "test:auth-confirmation": "node scripts/smoke-auth-confirmation.mjs",
    "test:realtime": "node scripts/smoke-realtime.mjs",
    "test:telegram": "node scripts/smoke-telegram.mjs",
    "import:legacy": "node scripts/legacy-import/import-legacy.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@openai/agents": "^0.17.2",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.5",
    "nestjs-pino": "^4.4.1",
    "network-as-code": "^10.0.0",
    "openai": "^7.13.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "string-width": "^4.2.3",
    "supertest": "^7.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.1.2"
  }
}
