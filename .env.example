# Client build-time values for the Flutter apps.
#
# The API base URL and public client tokens only. Nothing secret belongs in a
# Flutter binary or a web bundle — server secrets live in backend/.env, which
# is gitignored and documented in backend/.env.example.
#
# Debug builds fall back to http://127.0.0.1:3010/api/v1, so a local backend
# needs no value here. Release builds require it and reject non-HTTPS.
API_URL=https://api.bsheel.app/api/v1

# Public analytics token. Client-side by design; the app only initialises
# analytics after the user consents.
MIXPANEL_TOKEN=

# Google OAuth client IDs (public identifiers, not secrets).
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
