# ─── Dart / Flutter ──────────────────────────────────────────────────────────
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
.metadata

# Generated files (build_runner, freezed, mockito)
*.g.dart
*.freezed.dart
*.mocks.dart
*.gen.dart

# Symbolication / obfuscation maps
app.*.symbols
app.*.map.json

# ─── Environment / Secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Supabase ────────────────────────────────────────────────────────────────
.supabase/
supabase/.temp/

# ─── Node (edge functions) ───────────────────────────────────────────────────
node_modules/
supabase/functions/**/node_modules/

# ─── Platform build artifacts ────────────────────────────────────────────────
# Android
**/android/.gradle/
**/android/local.properties
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/key.properties
**/android/keystore/
*.jks
*.keystore

# iOS
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/.last_build_id
**/ios/Runner.xcworkspace/

# Desktop platforms (not targeted — auto-generated by Flutter tooling)
**/linux/
**/windows/
**/macos/

# Web (uncomment if not targeting web)
# **/web/

# ─── Coverage / Logs ─────────────────────────────────────────────────────────
coverage/
lcov.info
*.log

# ─── Melos ───────────────────────────────────────────────────────────────────
.melos/

# FVM (Flutter Version Manager)
**/.fvm/

# ─── IDEs ────────────────────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── OS ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Pubspec locks ───────────────────────────────────────────────────────────
# Keep locks for apps (reproducible builds), ignore for packages (library compat)
packages/**/pubspec.lock
apps/mobile_app/ios/AuthKey_V5L2554CT7.p8
apps/mobile_app/ios/Runner/GoogleService-Info.plist
*.p8
# M13 (2026-05-17): defense-in-depth on common signing/secret formats.
*.p12
*.pem
*.cer
*.mobileprovision
AuthKey_*.p8
apps/mobile_app/android/key.properties
*.jks
apps/mobile_app/android/app/google-services.json

# Local Claude state stays out, but the shipping runbooks are part of the project.
# Note the `/*`: git cannot re-include anything inside a directory that is itself excluded,
# so `.claude/` followed by `!.claude/skills/` silently does nothing.
.claude/*
!.claude/skills/
SECRETS_*.txt

# wrangler local cache
.wrangler/
**/.wrangler/

# Vercel (retired — admin is self-hosted behind Caddy; ignore stray CLI metadata)
.vercel/
**/.vercel/

# Shared client build config (client-safe keys, but keep it out of git)
bsheel-app-env.local.json
